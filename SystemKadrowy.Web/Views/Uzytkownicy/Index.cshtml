@using Microsoft.AspNetCore.Identity
@model IEnumerable<IdentityUser>

@{
    ViewData["Title"] = "Użytkownicy";
}

<style>
    /* 1. Nagłówek (Styl Admin - Ciemny Fiolet/Granat) */
    .page-header {
        background: linear-gradient(135deg, #4c51bf 0%, #667eea 100%);
        color: white;
        padding: 2rem;
        border-radius: 12px;
        margin-bottom: 2rem;
        box-shadow: 0 4px 6px rgba(76, 81, 191, 0.3);
    }

        .page-header h1 {
            margin: 0 0 0.5rem 0;
            font-size: 2rem;
            font-weight: 600;
        }

        .page-header p {
            margin: 0;
            opacity: 0.9;
        }

    /* 2. Pasek akcji */
    .action-bar {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 1.5rem;
    }

    .btn-primary-custom {
        background: #4c51bf;
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        border: none;
        box-shadow: 0 2px 4px rgba(76, 81, 191, 0.3);
    }

        .btn-primary-custom:hover {
            background: #434190;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(76, 81, 191, 0.4);
            color: white;
        }

    /* 3. Tabela */
    .card-table {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        overflow: hidden;
    }

    .table-custom {
        margin: 0;
        width: 100%;
        border-collapse: collapse;
    }

        .table-custom thead {
            background: #f8f9fa;
            border-bottom: 2px solid #e9ecef;
        }

            .table-custom thead th {
                padding: 1rem 1.5rem;
                font-weight: 600;
                color: #495057;
                font-size: 0.875rem;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                border: none;
            }

        .table-custom tbody tr {
            border-bottom: 1px solid #f1f3f5;
            transition: background-color 0.2s ease;
        }

            .table-custom tbody tr:hover {
                background-color: #f8f9fa;
            }

        .table-custom tbody td {
            padding: 1rem 1.5rem;
            vertical-align: middle;
            color: #495057;
            border: none;
        }

    /* 4. Style specyficzne dla Usera */
    .user-email {
        font-weight: 600;
        color: #2d3748;
        font-size: 1rem;
    }

    .user-id {
        font-family: 'Consolas', monospace;
        color: #718096;
        font-size: 0.85rem;
        background: #edf2f7;
        padding: 2px 6px;
        border-radius: 4px;
    }

    /* 5. Przyciski akcji */
    .action-buttons {
        display: flex;
        gap: 0.5rem;
        justify-content: flex-end;
    }

    .btn-action {
        padding: 0.4rem 0.8rem;
        border-radius: 6px;
        text-decoration: none;
        font-size: 0.875rem;
        font-weight: 500;
        transition: all 0.2s ease;
        border: 1px solid transparent;
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
    }

    .btn-edit {
        color: #4c51bf;
        border-color: #4c51bf;
        background: transparent;
    }

        .btn-edit:hover {
            background: #4c51bf;
            color: white;
        }

    .btn-delete {
        color: #fa5252;
        border-color: #fa5252;
        background: transparent;
    }

        .btn-delete:hover {
            background: #fa5252;
            color: white;
        }

    /* 6. Empty State */
    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        color: #868e96;
    }
</style>

<div class="page-header">
    <h1>👥 Użytkownicy Systemu</h1>
    <p>Zarządzaj kontami, dostępem i rolami w aplikacji</p>
</div>

<div class="action-bar">
    <a asp-controller="Pracownicy" asp-action="Create" class="btn-primary-custom">
        <span>+</span> Nowy Pracownik (z kontem)
    </a>
</div>

<div class="card-table">
    @if (Model.Any())
    {
        <table class="table-custom">
            <thead>
                <tr>
                    <th>Email / Login</th>
                    <th>Identyfikator (GUID)</th>
                    <th style="text-align: right;">Akcje</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>
                            <div class="user-email">@user.Email</div>
                        </td>
                        <td>
                            <span class="user-id">@user.Id</span>
                        </td>
                        <td>
                            <div class="action-buttons">
                                <a asp-action="Edit" asp-route-id="@user.Id" class="btn-action btn-edit">
                                    🛡️ Edytuj / Role
                                </a>
                                <a asp-action="Delete" asp-route-id="@user.Id" class="btn-action btn-delete">
                                    🗑️ Usuń
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <h3>Brak użytkowników</h3>
            <p>Lista użytkowników w systemie jest pusta.</p>
        </div>
    }
</div>