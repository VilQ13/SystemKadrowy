@model SystemKadrowy.Web.Models.EdytujUzytkownikaViewModel

@{
    ViewData["Title"] = "Edycja Użytkownika";
}

<style>
    .page-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 2rem;
        border-radius: 12px;
        margin-bottom: 2rem;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

        .page-header h1 {
            margin: 0 0 0.5rem 0;
            font-size: 2rem;
            font-weight: 600;
        }

        .page-header p {
            margin: 0;
            opacity: 0.9;
            font-size: 0.95rem;
        }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: #667eea;
        text-decoration: none;
        font-weight: 500;
        margin-bottom: 1.5rem;
        transition: all 0.2s ease;
    }

        .back-link:hover {
            color: #5568d3;
            gap: 0.7rem;
        }

    .form-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        padding: 2rem;
        max-width: 800px;
    }

    .section-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: #212529;
        margin-bottom: 1.5rem;
        padding-bottom: 0.75rem;
        border-bottom: 2px solid #f1f3f5;
        margin-top: 1rem;
    }

    .form-label-custom {
        font-weight: 600;
        color: #495057;
        margin-bottom: 0.5rem;
        font-size: 0.9rem;
    }

    .form-control-custom {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 0.75rem;
        transition: all 0.2s ease;
        font-size: 0.95rem;
    }

        .form-control-custom:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
            outline: none;
        }

    .form-group-custom {
        margin-bottom: 1.5rem;
    }

    .roles-card {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border-radius: 10px;
        padding: 1.5rem;
        border: 1px solid #dee2e6;
        border-left: 4px solid #667eea;
    }

    .role-item {
        background: white;
        border: 1px solid #dee2e6;
        padding: 0.75rem 1rem;
        border-radius: 8px;
        margin-bottom: 0.5rem;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

        .role-item:hover {
            border-color: #667eea;
            background: #f8f9ff;
        }

    .form-check-input {
        width: 1.2em;
        height: 1.2em;
        cursor: pointer;
        margin-top: 0;
    }

    .form-check-label {
        cursor: pointer;
        font-weight: 500;
        color: #495057;
        flex: 1;
    }

    .btn-save {
        background: linear-gradient(135deg, #51cf66 0%, #40c057 100%);
        color: white;
        padding: 0.875rem 2.5rem;
        border-radius: 8px;
        border: none;
        font-weight: 600;
        font-size: 1rem;
        transition: all 0.3s ease;
        box-shadow: 0 2px 4px rgba(81, 207, 102, 0.3);
        cursor: pointer;
    }

        .btn-save:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(81, 207, 102, 0.4);
        }

    .text-danger {
        font-size: 0.85rem;
        margin-top: 0.25rem;
        display: block;
    }
</style>

<a asp-action="Index" class="back-link">
    ← Powrót do listy
</a>

<div class="page-header">
    <h1>🛡️ Edycja Użytkownika</h1>
    <p>Zarządzaj dostępem i rolami w systemie</p>
</div>

<div class="form-card">
    <form asp-action="Edit">
        <input type="hidden" asp-for="Id" />

        <div class="section-title" style="margin-top: 0;">Dane logowania</div>

        <div class="form-group-custom">
            <label asp-for="Email" class="form-label-custom">Adres Email (Login)</label>
            <input asp-for="Email" class="form-control form-control-custom" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="section-title">Uprawnienia i Role</div>

        <div class="roles-card">
            <p class="text-muted small mb-3">Zaznacz role, które mają być przypisane do tego użytkownika:</p>

            @if (Model.DostepneRole != null)
            {
                foreach (var rola in Model.DostepneRole)
                {
                    bool czyMaRole = Model.PrzypisaneRole.Contains(rola);

                    <div class="role-item">
                        <input class="form-check-input" type="checkbox"
                               name="WybraneRole"
                               value="@rola"
                               id="role_@rola"
                               @(czyMaRole ? "checked" : "")>
                        <label class="form-check-label" for="role_@rola">
                            @rola
                        </label>
                        <span style="color: #cbd5e0;">🛡️</span>
                    </div>
                }
            }
            else
            {
                <div class="text-muted">Brak dostępnych ról do konfiguracji.</div>
            }
        </div>

        <div class="form-group-custom" style="margin-top: 2.5rem;">
            <button type="submit" class="btn-save">💾 Zapisz zmiany</button>
        </div>
    </form>
</div>