@model SystemKadrowy.Web.Models.EdytujUzytkownikaViewModel

@{
    ViewData["Title"] = "Edycja Użytkownika";
}

<h1>Edycja Użytkownika</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-3">
                <label asp-for="Email" class="control-label fw-bold"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="card mb-3">
                <div class="card-header bg-secondary text-white">
                    Uprawnienia (Role)
                </div>
                <div class="card-body">
                    <p class="text-muted small">Zaznacz role, które ma posiadać ten użytkownik:</p>

                    @if (Model.DostepneRole != null)
                    {
                        foreach (var rola in Model.DostepneRole)
                        {
                            bool czyMaRole = Model.PrzypisaneRole.Contains(rola);

                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       name="WybraneRole"
                                       value="@rola"
                                       id="role_@rola"
                                @(czyMaRole ? "checked" : "")>
                                <label class="form-check-label" for="role_@rola">
                                    @rola
                                </label>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">💾 Zapisz zmiany</button>
                <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
            </div>
        </form>
    </div>
</div>