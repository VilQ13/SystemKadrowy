@model SystemKadrowy.Web.Models.RejestracjaViewModel

@{
    ViewData["Title"] = "Nowy Użytkownik";
}

<h1>Utwórz Użytkownika</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control" placeholder="imie@firma.pl" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Haslo" class="control-label">Hasło</label>
                <input asp-for="Haslo" class="form-control" type="password" />
                <span asp-validation-for="Haslo" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Rola" class="control-label">Rola w systemie</label>
                <select asp-for="Rola" class="form-control" asp-items="ViewBag.Role"></select>
                <span asp-validation-for="Rola" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Utwórz konto" class="btn btn-success" />
                <a asp-action="Index" class="btn btn-secondary">Powrót</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}