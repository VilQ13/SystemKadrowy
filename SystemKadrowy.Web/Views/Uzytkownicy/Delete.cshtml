@using Microsoft.AspNetCore.Identity
@model IdentityUser

@{
    ViewData["Title"] = "Usuń Użytkownika";
}

<div class="alert alert-danger shadow-sm">
    <h3><i class="bi bi-exclamation-triangle"></i> Czy na pewno chcesz usunąć to konto?</h3>
    <p class="mb-0">Operacja jest nieodwracalna. Użytkownik straci dostęp do systemu.</p>
</div>

<div class="card border-danger mb-4" style="max-width: 500px;">
    <div class="card-body">
        <h5 class="card-title">@Model.Email</h5>
        <p class="card-text text-muted">ID: @Model.Id</p>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger w-100">Tak, usuń trwale</button>
        </form>
    </div>
</div>

<a asp-action="Index" class="btn btn-outline-secondary">⬅ Powrót do listy</a>