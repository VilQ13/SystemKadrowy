@model IEnumerable<SystemKadrowy.Core.Domain.Wyplata>

@{
    ViewData["Title"] = "Historia Wypłat";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>📜 Archiwum Wypłat</h1>
    <a asp-action="Index" class="btn btn-secondary">⬅ Wróć do generatora</a>
</div>

<table class="table table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>Pracownik</th>
            <th>Okres</th>
            <th>Data Utworzenia</th>
            <th class="text-end">Do Wypłaty</th>
            <th class="text-center">Akcje</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <strong>@item.Pracownik.Nazwisko @item.Pracownik.Imie</strong>
                    <br />
                    <small class="text-muted">PESEL: @item.Pracownik.PESEL</small>
                </td>
                <td>
                    <span class="badge bg-info text-dark">
                        @item.Miesiac / @item.Rok
                    </span>
                </td>
                <td>@item.DataGenerowania.ToString("dd.MM.yyyy HH:mm")</td>
                <td class="text-end fw-bold text-success">
                    @item.DoWyplaty.ToString("N2") zł
                </td>
                <td class="text-center">
                    <a asp-action="Drukuj" asp-route-id="@item.Id" class="btn btn-danger btn-sm" target="_blank">
                        <i class="bi bi-file-earmark-pdf"></i> Drukuj PDF
                    </a>

                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm ms-1">
                        Szczegóły
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-warning text-center">
        Brak wygenerowanych wypłat w systemie.
    </div>
}