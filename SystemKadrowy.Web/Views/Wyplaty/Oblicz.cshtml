@using SystemKadrowy.Core.Interfaces
@model WynikWyplaty

@{
    var p = ViewBag.Pracownik as SystemKadrowy.Core.Domain.Pracownik;
    ViewData["Title"] = "Pasek Wypłaty";
}

<div class="card mt-4">
    <div class="card-header bg-primary text-white">
        <div class="d-flex justify-content-between align-items-center">
            <h3>Pasek Wynagrodzeń: @p.Imie @p.Nazwisko</h3>
            <h4 class="bg-white text-primary px-3 py-1 rounded">
                Okres: @ViewBag.Miesiac / @ViewBag.Rok
            </h4>
        </div>
    </div>
    <div class="card mb-4 bg-light">
        <div class="card-body">
            <form method="get" asp-action="Oblicz" class="row align-items-end">
                <input type="hidden" name="id" value="@ViewBag.Pracownik.Id" />
                <input type="hidden" name="rok" value="@ViewBag.Rok" />
                <input type="hidden" name="miesiac" value="@ViewBag.Miesiac" />

                <div class="col-md-3">
                    <label class="form-label fw-bold">Premia / Dodatki (Brutto)</label>
                    <div class="input-group">
                        <input type="number" step="0.01" name="premia" class="form-control" value="@ViewBag.WpisanaPremia" />
                        <span class="input-group-text">PLN</span>
                    </div>
                </div>

                @if (ViewBag.Pracownik.Umowy[0].SposobWynagradzania.ToString() == "StawkaGodzinowa")
                {
                    <div class="col-md-3">
                        <label class="form-label fw-bold text-primary">Godziny Pracy</label>
                        <div class="input-group">
                            <input type="number" step="0.5" name="godziny" class="form-control" value="@ViewBag.WpisaneGodziny" />
                            <span class="input-group-text">h</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="col-md-3">
                        <label class="form-label text-muted">Godziny Pracy</label>
                        <input type="text" class="form-control" value="Etat (Stała pensja)" disabled />
                        <input type="hidden" name="godziny" value="168" />
                    </div>
                }

                <div class="col-md-3">
                    <label class="form-label fw-bold text-danger">Komornik / Potrącenia (Netto)</label>
                    <div class="input-group">
                        <input type="number" step="0.01" name="potracenie" class="form-control" value="@ViewBag.WpisanePotracenie" />
                        <span class="input-group-text">PLN</span>
                    </div>
                </div>

                <div class="col-md-3">
                    <button type="submit" class="btn btn-warning w-100">🔄 Przelicz Wypłatę</button>
                </div>
            </form>
        </div>
    </div>
    @if (ViewBag.AiWarning != null)
    {
        <div class="alert alert-danger shadow-sm border-danger">
            <div class="d-flex align-items-center">
                <i class="bi bi-robot fs-1 me-3"></i> <div>
                    <h5 class="alert-heading">Sztuczna Inteligencja ostrzega!</h5>
                    <p class="mb-0">@ViewBag.AiWarning</p>
                    <small>Sprawdź, czy nie wpisano pomyłkowo dodatkowego zera.</small>
                </div>
            </div>
        </div>
    }
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <h5>Dane podstawowe</h5>
                <hr />
                <p><strong>Brutto:</strong> @Model.Brutto.ToString("C")</p>
                <p><strong>Podstawa ZUS:</strong> @Model.Brutto.ToString("C")</p>

                <p>
                    Stawka z umowy: @ViewBag.Pracownik.Umowy[0].StawkaBrutto.ToString("C")
                    (@ViewBag.Pracownik.Umowy[0].SposobWynagradzania)
                </p>
                @if (ViewBag.Pracownik.Umowy[0].SposobWynagradzania.ToString() == "StawkaGodzinowa")
                {
                    <p class="text-primary">
                        Wyliczenie: @ViewBag.WpisaneGodziny h * @ViewBag.Pracownik.Umowy[0].StawkaBrutto.ToString("C")
                    </p>
                }

                <h5 class="mt-4 text-danger">Składki ZUS (Społeczne)</h5>
                <hr />
                <p>Emerytalne (9.76%): <span class="float-end text-danger">-@Model.ZUS_Emerytalne.ToString("C")</span></p>
                <p>Rentowe (1.50%): <span class="float-end text-danger">-@Model.ZUS_Rentowe.ToString("C")</span></p>
                <p>Chorobowe (2.45%): <span class="float-end text-danger">-@Model.ZUS_Chorobowe.ToString("C")</span></p>
                <p class="fw-bold">Razem ZUS: <span class="float-end text-danger">-@Model.ZUS_Razem.ToString("C")</span></p>
            </div>

            <div class="col-md-6">
                <h5 class="text-warning">Ubezpieczenie Zdrowotne</h5>
                <hr />
                <p>Podstawa wymiaru: @((Model.Brutto - Model.ZUS_Razem).ToString("C"))</p>
                <p class="fw-bold">Składka NFZ (9%): <span class="float-end text-warning">-@Model.SkladkaZdrowotna.ToString("C")</span></p>

                <h5 class="mt-4 text-secondary">Podatek Dochodowy (PIT)</h5>
                <hr />
                <p>Koszty uzyskania: @Model.KosztyUzyskania.ToString("C")</p>
                <p>Podstawa opodatkowania: @Model.PodstawaOpodatkowania.ToString("C")</p>
                <p class="fw-bold">Zaliczka na PIT: <span class="float-end text-secondary">-@Model.Podatek.ToString("C")</span></p>
                <p>Podstawa z umowy: @Model.Brutto.ToString("C")</p>

                @if (Model.PotracenieZaNieobecnosci > 0)
                {
                    <p class="text-danger">
                        Potrącenie za nieobecności: -@Model.PotracenieZaNieobecnosci.ToString("C")
                    </p>
                }

                @if (Model.WynagrodzenieChorobowe > 0)
                {
                    <p class="text-info fw-bold">
                        + Wynagrodzenie Chorobowe (80%): @Model.WynagrodzenieChorobowe.ToString("C")
                    </p>
                }

                @if (Model.PremiaBrutto > 0)
                {
                    <p class="text-success">Premia: +@Model.PremiaBrutto.ToString("C")</p>
                }
                <hr />
                <p><strong>Całkowite Brutto: @Model.CalicowiteBrutto.ToString("C")</strong></p>

                <h5 class="mt-4 text-danger">Potrącenia z Netto</h5>
                <hr />
                <p>Komornik / Inne: <span class="float-end text-danger">-@Model.PotraceniaKomornicze.ToString("C")</span></p>

            </div>
        </div>

        <div class="row mt-4">
            <div class="col-12">
                <div class="alert alert-success text-center mt-3">
                    <h1>DO WYPŁATY: @Model.DoWyplaty.ToString("C")</h1>
                    <small>(Netto: @Model.Netto.ToString("C") - Potrącenia)</small>
                </div>
            </div>
        </div>

        <hr class="my-4" />

        <div class="d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-secondary">Anuluj / Wróć</a>

            <form asp-action="Zatwierdz" method="post">
                <input type="hidden" name="id" value="@ViewBag.Pracownik.Id" />
                <input type="hidden" name="rok" value="@ViewBag.Rok" />
                <input type="hidden" name="miesiac" value="@ViewBag.Miesiac" />
                <input type="hidden" name="premia" value="@Model.PremiaBrutto" /> 
                <input type="hidden" name="potracenie" value="@Model.PotraceniaKomornicze" />

                <button type="submit" class="btn btn-primary btn-lg" onclick="return confirm('Czy na pewno chcesz zatwierdzić i zaksięgować tę wypłatę?');">
                    💾 Zatwierdź Wypłatę
                </button>
            </form>
        </div>

        <a asp-action="Index" class="btn btn-secondary">Wróć do listy</a>
    </div>
</div>