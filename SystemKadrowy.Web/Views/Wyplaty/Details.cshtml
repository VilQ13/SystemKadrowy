@model SystemKadrowy.Core.Domain.Wyplata

@{
    ViewData["Title"] = "Szczegóły wypłaty";
}

<style>
    /* 1. Nagłówek (Finansowy - Zielony) */
    .page-header {
        background: linear-gradient(135deg, #51cf66 0%, #2f9e44 100%);
        color: white;
        padding: 2rem;
        border-radius: 12px;
        margin-bottom: 2rem;
        box-shadow: 0 4px 6px rgba(47, 158, 68, 0.3);
    }

        .page-header h1 {
            margin: 0 0 0.5rem 0;
            font-size: 2rem;
            font-weight: 600;
        }

        .page-header p {
            margin: 0;
            opacity: 0.9;
        }

    /* 2. Link powrotu */
    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: #2f9e44;
        text-decoration: none;
        font-weight: 500;
        margin-bottom: 1.5rem;
        transition: all 0.2s ease;
    }

        .back-link:hover {
            color: #2b8a3e;
            gap: 0.7rem;
        }

    /* 3. Karta Paska Płacowego */
    .payslip-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.08);
        overflow: hidden;
        max-width: 900px;
        margin: 0 auto;
    }

    /* Sekcja nagłówkowa w karcie */
    .payslip-header {
        background: #f8f9fa;
        padding: 1.5rem 2rem;
        border-bottom: 2px solid #e9ecef;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .employee-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: #212529;
        margin: 0;
    }

    .payslip-period {
        background: #e9ecef;
        color: #495057;
        padding: 0.4rem 1rem;
        border-radius: 50px;
        font-weight: 600;
        font-size: 0.9rem;
    }

    /* Info Banner (Archiwum) */
    .archive-banner {
        background: #fff9db;
        color: #e67700;
        padding: 0.75rem 2rem;
        font-size: 0.9rem;
        border-bottom: 1px solid #ffe066;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    /* Siatka finansowa */
    .finance-grid {
        display: grid;
        grid-template-columns: 1fr 1fr; /* Dwie równe kolumny */
        gap: 0; /* Brak odstępu, linia oddzielająca */
    }

    .finance-column {
        padding: 2rem;
    }

    /* Linia pionowa między kolumnami (tylko na desktop) */
    @@media (min-width: 768px) {
        .finance-column:first-child

    {
        border-right: 1px solid #f1f3f5;
    }

    }

    /* Na mobilce jedna pod drugą */
    @@media (max-width: 767px) {
        .finance-grid

    {
        grid-template-columns: 1fr;
    }

    .finance-column:first-child {
        border-bottom: 1px solid #f1f3f5;
    }

    }

    .col-title {
        font-size: 1rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 600;
        color: #adb5bd;
        margin-bottom: 1.5rem;
    }

    /* Wiersze z kwotami */
    .amount-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.75rem 0;
        border-bottom: 1px dashed #e9ecef;
    }

        .amount-row:last-child {
            border-bottom: none;
        }

    .label {
        color: #495057;
        font-weight: 500;
    }

    .value {
        font-family: 'Consolas', monospace;
        font-weight: 600;
        font-size: 1.1rem;
    }

    .val-positive {
        color: #212529;
    }

    .val-negative {
        color: #fa5252;
    }

    .val-neutral {
        color: #495057;
    }

    /* Sekcja Netto */
    .net-pay-section {
        background: linear-gradient(135deg, #51cf66 0%, #2f9e44 100%);
        color: white;
        padding: 2rem;
        text-align: center;
    }

    .net-label {
        font-size: 1rem;
        text-transform: uppercase;
        opacity: 0.9;
        margin-bottom: 0.5rem;
        display: block;
    }

    .net-value {
        font-size: 3rem;
        font-weight: 700;
        line-height: 1;
    }

    /* Przyciski na dole */
    .footer-actions {
        padding: 1.5rem;
        background: #f8f9fa;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .btn-print {
        background: #212529;
        color: white;
        padding: 0.6rem 1.2rem;
        border-radius: 8px;
        text-decoration: none;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

        .btn-print:hover {
            background: #000;
            color: white;
            transform: translateY(-2px);
        }

    .btn-back {
        color: #495057;
        text-decoration: none;
        font-weight: 500;
    }

        .btn-back:hover {
            color: #000;
        }

    .sub-info {
        display: block;
        font-size: 0.8rem;
        color: #868e96;
        margin-top: 0.2rem;
        font-style: italic;
    }
</style>

<a asp-action="Historia" class="back-link">
    ← Powrót do historii
</a>

<div class="page-header">
    <h1>💰 Pasek Wynagrodzeń</h1>
    <p>Szczegółowe rozliczenie okresu</p>
</div>

<div class="payslip-card">

    <div class="payslip-header">
        <div>
            <div style="font-size: 0.85rem; color: #868e96; text-transform: uppercase;">Pracownik</div>
            <h3 class="employee-title">@Model.Pracownik.Imie @Model.Pracownik.Nazwisko</h3>
        </div>
        <div class="payslip-period">
            Okres: @Model.Miesiac / @Model.Rok
        </div>
    </div>

    <div class="archive-banner">
        <span>🔒</span>
        <span>
            <strong>Zatwierdzono:</strong> @Model.DataGenerowania.ToString("dd.MM.yyyy HH:mm"). Danych nie można edytować.
        </span>
    </div>

    <div class="finance-grid">

        <div class="finance-column">
            <div class="col-title">Naliczenia</div>

            <div class="amount-row">
                <span class="label">Wynagrodzenie Zasadnicze (Brutto)</span>
                <span class="value val-positive">@Model.Brutto.ToString("N2") zł</span>
            </div>

            <div class="amount-row">
                <span class="label">Wynagrodzenie Chorobowe</span>
                <span class="value val-positive">@Model.WynagrodzenieChorobowe.ToString("N2") zł</span>
            </div>

            <div style="margin-top: 2rem; padding-top: 1rem; border-top: 2px solid #f1f3f5;">
                <span class="label" style="font-weight: 700;">Podstawa opodatkowania</span>
                <div style="float: right; font-weight: 700;">@((Model.Brutto + Model.WynagrodzenieChorobowe - Model.ZUS_Razem - Model.PotracenieZaNieobecnosci).ToString("N2")) zł</div>
            </div>
        </div>

        <div class="finance-column">
            <div class="col-title">Potrącenia i Podatki</div>

            <div class="amount-row">
                <div class="d-flex flex-column">
                    <span class="label">Potrącenie za nieobecności</span>
                    @if (Model.PotracenieZaNieobecnosci > 0)
                    {
                        @if (Model.IleGodzinNieobecnosci > 0)
                        {
                            <span class="sub-info">Wyjścia prywatne: @Model.IleGodzinNieobecnosci.ToString("0.##") godz.</span>
                        }
                        else if (Model.IleDniNieobecnosci > 0)
                        {
                            <span class="sub-info">L4 / Bezpłatny: @Model.IleDniNieobecnosci dni</span>
                        }
                    }
                </div>
                <span class="value val-negative">-@Model.PotracenieZaNieobecnosci.ToString("N2") zł</span>
            </div>

            <div class="amount-row">
                <span class="label">Składki ZUS (Razem)</span>
                <span class="value val-negative">-@Model.ZUS_Razem.ToString("N2") zł</span>
            </div>

            <div class="amount-row">
                <span class="label">Składka Zdrowotna</span>
                <span class="value val-negative">-@Model.SkladkaZdrowotna.ToString("N2") zł</span>
            </div>

            <div class="amount-row">
                <span class="label">Zaliczka na podatek PIT</span>
                <span class="value val-negative">-@Model.Podatek.ToString("N2") zł</span>
            </div>

            <div class="amount-row">
                <span class="label text-muted">Koszty uzyskania przychodu (info)</span>
                <span class="value val-neutral" style="font-size: 0.9rem;">@Model.KosztyUzyskania.ToString("N2") zł</span>
            </div>
        </div>
    </div>

    <div class="net-pay-section">
        <span class="net-label">Do Wypłaty (Netto)</span>
        <div class="net-value">@Model.Netto.ToString("N2") zł</div>
    </div>

    <div class="footer-actions">
        <a asp-controller="Pracownicy" asp-action="Details" asp-route-id="@Model.PracownikId" class="btn-back">
            Przejdź do profilu pracownika
        </a>

        <a asp-controller="Wyplaty" asp-action="Drukuj" asp-route-id="@Model.Id" class="btn-print" target="_blank">
            🖨️ Drukuj Pasek (PDF)
        </a>
    </div>

</div>