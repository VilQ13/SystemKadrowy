@model IEnumerable<SystemKadrowy.Core.Domain.Pracownik>

@{
    ViewData["Title"] = "Lista Płac";
    var obecnyMiesiac = DateTime.Now.ToString("yyyy-MM");
}

<h1>Generowanie Listy Płac</h1>


<div class="card mb-4 border-primary">
    <div class="card-header bg-primary text-white">
        Ustawienia Generatora
    </div>
    <div class="card-body bg-light">
        <div class="row align-items-center">
            <div class="col-auto">
                <label for="okres" class="col-form-label fw-bold">Wybierz okres rozliczeniowy:</label>
            </div>
            <div class="col-auto">
                <input type="month" id="okres" name="okres" class="form-control fw-bold text-primary" value="@obecnyMiesiac" onchange="zaktualizujLinki()" />
            </div>
            <div class="col-auto">
                <small class="text-muted">Zmiana daty automatycznie zaktualizuje linki "Oblicz" poniżej.</small>
            </div>
            <div class="col-auto ms-auto">
                <a asp-action="Historia" class="btn btn-outline-primary me-2">
                    📜 Przeglądaj Historię
                </a>

                <a asp-action="EksportExcel" class="btn btn-success">
                    📥 Pobierz Raport (Excel)
                </a>
            </div>
        </div>
    </div>
</div>

<table class="table table-hover table-striped">
    <thead class="table-dark">
        <tr>
            <th>Imię i Nazwisko</th>
            <th>PESEL</th>
            <th class="text-end">Akcja</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="align-middle">
                    <strong>@item.Imie @item.Nazwisko</strong>
                    <br />
                    <small class="text-muted">@item.Email</small>
                </td>
                <td class="align-middle">@item.PESEL</td>
                <td class="text-end">
                    <a href="#" data-id="@item.Id" class="btn-oblicz btn btn-outline-success btn-sm">
                        💰 Oblicz Wypłatę
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        function zaktualizujLinki() {
            var dataInput = document.getElementById('okres').value;
            var czesci = dataInput.split('-');
            var rok = czesci[0];
            var miesiac = czesci[1];

            var przyciski = document.getElementsByClassName('btn-oblicz');

            for (var i = 0; i < przyciski.length; i++) {
                var btn = przyciski[i];
                var idPracownika = btn.getAttribute('data-id');
                var nowyLink = '/Wyplaty/Oblicz/' + idPracownika + '?rok=' + rok + '&miesiac=' + miesiac;
                btn.href = nowyLink;
            }
        }

        document.addEventListener("DOMContentLoaded", function() {
            zaktualizujLinki();
        });
    </script>
}