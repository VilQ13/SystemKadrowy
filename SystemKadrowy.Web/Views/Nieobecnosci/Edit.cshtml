@model SystemKadrowy.Core.Domain.Nieobecnosc

@{
    ViewData["Title"] = "Edycja nieobecności";
}

<style>
    .page-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 2rem;
        border-radius: 12px;
        margin-bottom: 2rem;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

        .page-header h1 {
            margin: 0 0 0.5rem 0;
            font-size: 2rem;
            font-weight: 600;
        }

        .page-header p {
            margin: 0;
            opacity: 0.9;
            font-size: 0.95rem;
        }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: #667eea;
        text-decoration: none;
        font-weight: 500;
        margin-bottom: 1.5rem;
        transition: all 0.2s ease;
    }

        .back-link:hover {
            color: #5568d3;
            gap: 0.7rem;
        }

    .form-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        padding: 2rem;
        max-width: 800px;
    }

    .form-label-custom {
        font-weight: 600;
        color: #495057;
        margin-bottom: 0.5rem;
        font-size: 0.9rem;
    }

    .form-control-custom {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 0.75rem;
        transition: all 0.2s ease;
        font-size: 0.95rem;
    }

        .form-control-custom:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
            outline: none;
        }

        .form-control-custom[readonly] {
            background-color: #e9ecef;
            cursor: not-allowed;
        }

    .form-group-custom {
        margin-bottom: 1.5rem;
    }

    .mode-selection-card {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border-radius: 10px;
        padding: 1.5rem;
        border: 1px solid #dee2e6;
        margin-bottom: 2rem;
        border-left: 4px solid #667eea;
    }

    .mode-title {
        font-weight: 600;
        color: #495057;
        margin-bottom: 1rem;
        display: block;
    }

    .form-check-custom {
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .form-check-label {
        cursor: pointer;
        color: #495057;
        font-weight: 500;
    }

    .btn-save {
        background: linear-gradient(135deg, #51cf66 0%, #40c057 100%);
        color: white;
        padding: 0.875rem 2.5rem;
        border-radius: 8px;
        border: none;
        font-weight: 600;
        font-size: 1rem;
        transition: all 0.3s ease;
        box-shadow: 0 2px 4px rgba(81, 207, 102, 0.3);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

        .btn-save:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(81, 207, 102, 0.4);
        }

    .text-danger {
        font-size: 0.85rem;
        margin-top: 0.25rem;
        display: block;
    }
</style>

<a asp-action="Index" class="back-link">
    ← Powrót do listy
</a>

<div class="page-header">
    <h1>✏️ Edycja nieobecności</h1>
    <p>Zmień parametry zarejestrowanego wniosku</p>
</div>

<div class="form-card">
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />

        <div class="row">
            <div class="col-md-6">
                <div class="form-group-custom">
                    <label asp-for="PracownikId" class="form-label-custom">👤 Pracownik</label>
                    <select asp-for="PracownikId" class="form-control form-control-custom" asp-items="ViewBag.PracownikId"></select>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group-custom">
                    <label asp-for="Typ" class="form-label-custom">📋 Rodzaj Nieobecności</label>
                    <select asp-for="Typ" class="form-control form-control-custom"
                            asp-items="Html.GetEnumSelectList<SystemKadrowy.Core.Enums.TypNieobecnosc>()">
                    </select>
                </div>
            </div>
        </div>

        <div class="mode-selection-card">
            <label class="mode-title">⚙️ Tryb edycji</label>

            <div class="form-check form-check-custom">
                <input class="form-check-input" type="radio" name="tryb" id="trybData" value="data">
                <label class="form-check-label" for="trybData">Wg dat (Od - Do)</label>
            </div>

            <div class="form-check form-check-custom">
                <input class="form-check-input" type="radio" name="tryb" id="trybDni" value="dni">
                <label class="form-check-label" for="trybDni">Wg liczby dni</label>
            </div>

            <div class="form-check form-check-custom">
                <input class="form-check-input" type="radio" name="tryb" id="trybGodziny" value="godziny">
                <label class="form-check-label" for="trybGodziny" style="color: #667eea; font-weight: 600;">Część dnia (Godziny)</label>
            </div>

            <div id="sekcjaGodzin" style="display:none; margin-top: 1rem; border-top: 1px dashed #dee2e6; padding-top: 1rem;">
                <label asp-for="LiczbaGodzin" class="form-label-custom text-primary">⏱️ Ile godzin nieobecności?</label>
                <input asp-for="LiczbaGodzin" type="number" step="0.5" class="form-control form-control-custom" id="inputGodziny" style="max-width: 150px;" />
                <small class="text-muted" style="display:block; margin-top:0.5rem;">Wpisz np. 2 lub 3,5. Data "Do" zostanie ustawiona tak samo jak "Od".</small>
            </div>
        </div>

        <div class="form-group-custom">
            <label asp-for="DataOd" class="form-label-custom">📅 Data Początkowa</label>
            <input asp-for="DataOd" type="date" class="form-control form-control-custom" id="inputDataOd" />
            <span asp-validation-for="DataOd" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group-custom">
                    <label asp-for="DataDo" class="form-label-custom">🏁 Data Końcowa</label>
                    <input asp-for="DataDo" type="date" class="form-control form-control-custom" id="inputDataDo" />
                    <span asp-validation-for="DataDo" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group-custom">
                    <label asp-for="LiczbaDniRoboczych" class="form-label-custom">🧮 Dni Robocze</label>
                    <input asp-for="LiczbaDniRoboczych" class="form-control form-control-custom" id="inputDni" readonly />
                    <span asp-validation-for="LiczbaDniRoboczych" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="form-group-custom" style="margin-top: 1rem;">
            <button type="submit" class="btn-save">
                💾 Zapisz zmiany
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const radioData = document.getElementById("trybData");
            const radioDni = document.getElementById("trybDni");
            const radioGodziny = document.getElementById("trybGodziny");

            const inputOd = document.getElementById("inputDataOd");
            const inputDo = document.getElementById("inputDataDo");
            const inputDni = document.getElementById("inputDni");

            const sekcjaGodzin = document.getElementById("sekcjaGodzin");
            const inputGodziny = document.getElementById("inputGodziny");

            // --- INICJALIZACJA Z MODELU ---
            const poczatkowaLiczbaGodzin = parseFloat('@Model.LiczbaGodzin'.replace(',', '.'));

            function zmienTryb() {
                // Reset widoczności
                sekcjaGodzin.style.display = "none";
                inputDo.removeAttribute("readonly");
                inputDni.removeAttribute("readonly");

                // Reset stylów
                inputDo.style.backgroundColor = "";
                inputDni.style.backgroundColor = "";

                if (radioData.checked) {
                    // Tryb 1: Data
                    inputDni.setAttribute("readonly", true);
                    inputDni.style.backgroundColor = "#e9ecef";
                    przeliczDniRobocze();

                } else if (radioDni.checked) {
                    // Tryb 2: Dni
                    inputDo.setAttribute("readonly", true);
                    inputDo.style.backgroundColor = "#e9ecef";
                    wyliczDateKocowa();

                } else if (radioGodziny.checked) {
                    // Tryb 3: Godziny
                    sekcjaGodzin.style.display = "block";

                    inputDo.setAttribute("readonly", true);
                    inputDo.style.backgroundColor = "#e9ecef";
                    if(!inputDo.value) inputDo.value = inputOd.value;

                    inputDni.setAttribute("readonly", true);
                    inputDni.style.backgroundColor = "#e9ecef";
                    inputDni.value = 0;
                }
            }

            // --- Funkcje logiczne ---
            function przeliczDniRobocze() {
                if (!inputOd.value || !inputDo.value) return;
                const start = new Date(inputOd.value);
                const end = new Date(inputDo.value);
                if (end < start) { inputDni.value = 0; return; }

                let count = 0;
                let current = new Date(start);
                while (current <= end) {
                    const dayOfWeek = current.getDay();
                    if (dayOfWeek !== 0 && dayOfWeek !== 6) count++;
                    current.setDate(current.getDate() + 1);
                }
                inputDni.value = count;
            }

            function wyliczDateKocowa() {
                if (!inputOd.value || !inputDni.value) return;
                let daysToAdd = parseInt(inputDni.value);
                if (daysToAdd <= 0) return;

                let current = new Date(inputOd.value);
                let addedDays = 0;
                let startDay = current.getDay();
                if (startDay !== 0 && startDay !== 6) addedDays = 1;

                while (addedDays < daysToAdd) {
                    current.setDate(current.getDate() + 1);
                    const dayOfWeek = current.getDay();
                    if (dayOfWeek !== 0 && dayOfWeek !== 6) addedDays++;
                }

                const yyyy = current.getFullYear();
                const mm = String(current.getMonth() + 1).padStart(2, '0');
                const dd = String(current.getDate()).padStart(2, '0');
                inputDo.value = `${yyyy}-${mm}-${dd}`;
            }

            // --- Listenery ---
            radioData.addEventListener("change", zmienTryb);
            radioDni.addEventListener("change", zmienTryb);
            radioGodziny.addEventListener("change", zmienTryb);

            inputOd.addEventListener("change", function() {
                if (radioGodziny.checked) inputDo.value = inputOd.value;
                else if (radioData.checked) przeliczDniRobocze();
                else wyliczDateKocowa();
            });

            inputDo.addEventListener("change", przeliczDniRobocze);
            inputDni.addEventListener("input", wyliczDateKocowa);

            // --- Start ---
            // Decyzja który tryb zaznaczyć na starcie
            if (poczatkowaLiczbaGodzin > 0) {
                radioGodziny.checked = true;
            } else {
                // Domyślnie tryb daty, chyba że byłby inny warunek
                radioData.checked = true;
            }

            zmienTryb();
        });
    </script>
}