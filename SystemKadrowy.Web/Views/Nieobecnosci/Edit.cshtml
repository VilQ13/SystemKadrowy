@model SystemKadrowy.Core.Domain.Nieobecnosc

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Nieobecnosc</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group mb-3">
                <label asp-for="PracownikId" class="control-label">Pracownik</label>
                <select asp-for="PracownikId" class="form-control" asp-items="ViewBag.PracownikId"></select>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Typ" class="control-label">Rodzaj Nieobecności</label>
                <select asp-for="Typ" class="form-control"
                        asp-items="Html.GetEnumSelectList<SystemKadrowy.Core.Enums.TypNieobecnosc>()">
                </select>
            </div>

            <div class="card bg-light mb-3">
                <div class="card-body py-2">
                    <label class="fw-bold mb-2">Jak chcesz wprowadzić okres?</label>

                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="tryb" id="trybData" value="data" checked>
                        <label class="form-check-label" for="trybData">Całe dni (wg Daty)</label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="tryb" id="trybDni" value="dni">
                        <label class="form-check-label" for="trybDni">Całe dni (wg Liczby dni)</label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="tryb" id="trybGodziny" value="godziny">
                        <label class="form-check-label" for="trybGodziny" class="text-primary fw-bold">Część dnia (Godziny)</label>
                    </div>
                </div>
            </div>

            <div class="row" id="sekcjaGodzin" style="display:none;">
                <div class="col-md-12 mb-3">
                    <label asp-for="LiczbaGodzin" class="control-label fw-bold text-primary">Ile godzin nieobecności?</label>
                    <input asp-for="LiczbaGodzin" type="number" step="0.5" class="form-control" id="inputGodziny" value="0" />
                    <small class="text-muted">Wpisz np. 2 lub 3,5. Data DO zostanie ustawiona taka sama jak Data OD.</small>
                </div>
            </div>

            <div class="form-group mb-3">
                <label asp-for="DataOd" class="control-label">Data Od (Początek)</label>
                <input asp-for="DataOd" type="date" class="form-control" id="inputDataOd" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="DataOd" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="DataDo" class="control-label">Data Do (Koniec)</label>
                    <input asp-for="DataDo" type="date" class="form-control" id="inputDataDo" />
                    <span asp-validation-for="DataDo" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="LiczbaDniRoboczych" class="control-label">Dni Robocze</label>
                    <input asp-for="LiczbaDniRoboczych" class="form-control" id="inputDni" readonly style="background-color: #e9ecef;" />
                    <span asp-validation-for="LiczbaDniRoboczych" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Zapisz Nieobecność" class="btn btn-primary btn-lg" />
                <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
