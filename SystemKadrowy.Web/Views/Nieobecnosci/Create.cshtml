@model SystemKadrowy.Core.Domain.Nieobecnosc

@{
    ViewData["Title"] = "Rejestracja Nieobecności";
}

<h1>Nowa Nieobecność</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="PracownikId" class="control-label">Pracownik</label>
                <select asp-for="PracownikId" class="form-control" asp-items="ViewBag.PracownikId"></select>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Typ" class="control-label">Rodzaj Nieobecności</label>
                <select asp-for="Typ" class="form-control"
                        asp-items="Html.GetEnumSelectList<SystemKadrowy.Core.Enums.TypNieobecnosc>()">
                </select>
            </div>

            <div class="card bg-light mb-3">
                <div class="card-body py-2">
                    <label class="fw-bold mb-2">Jak chcesz wprowadzić okres?</label>

                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="tryb" id="trybData" value="data" checked>
                        <label class="form-check-label" for="trybData">Całe dni (wg Daty)</label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="tryb" id="trybDni" value="dni">
                        <label class="form-check-label" for="trybDni">Całe dni (wg Liczby dni)</label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="tryb" id="trybGodziny" value="godziny">
                        <label class="form-check-label" for="trybGodziny" class="text-primary fw-bold">Część dnia (Godziny)</label>
                    </div>
                </div>
            </div>

            <div class="row" id="sekcjaGodzin" style="display:none;">
                <div class="col-md-12 mb-3">
                    <label asp-for="LiczbaGodzin" class="control-label fw-bold text-primary">Ile godzin nieobecności?</label>
                    <input asp-for="LiczbaGodzin" type="number" step="0.5" class="form-control" id="inputGodziny" value="0" />
                    <small class="text-muted">Wpisz np. 2 lub 3,5. Data DO zostanie ustawiona taka sama jak Data OD.</small>
                </div>
            </div>

            <div class="form-group mb-3">
                <label asp-for="DataOd" class="control-label">Data Od (Początek)</label>
                <input asp-for="DataOd" type="date" class="form-control" id="inputDataOd" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="DataOd" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="DataDo" class="control-label">Data Do (Koniec)</label>
                    <input asp-for="DataDo" type="date" class="form-control" id="inputDataDo" />
                    <span asp-validation-for="DataDo" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="LiczbaDniRoboczych" class="control-label">Dni Robocze</label>
                    <input asp-for="LiczbaDniRoboczych" class="form-control" id="inputDni" readonly style="background-color: #e9ecef;" />
                    <span asp-validation-for="LiczbaDniRoboczych" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Zapisz Nieobecność" class="btn btn-primary btn-lg" />
                <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const radioData = document.getElementById("trybData");
            const radioDni = document.getElementById("trybDni");
            const radioGodziny = document.getElementById("trybGodziny"); // Nowe

            const inputOd = document.getElementById("inputDataOd");
            const inputDo = document.getElementById("inputDataDo");
            const inputDni = document.getElementById("inputDni");

            const sekcjaGodzin = document.getElementById("sekcjaGodzin"); // Kontener inputa godzin
            const inputGodziny = document.getElementById("inputGodziny");

            function zmienTryb() {
                // Reset widoczności
                sekcjaGodzin.style.display = "none";
                inputDo.removeAttribute("readonly");
                inputDni.removeAttribute("readonly");
                inputDo.style.backgroundColor = "#fff";
                inputDni.style.backgroundColor = "#fff";

                if (radioData.checked) {
                    // Tryb 1: Data DO aktywna, Dni zablokowane
                    inputDni.setAttribute("readonly", true);
                    inputDni.style.backgroundColor = "#e9ecef";
                    inputGodziny.value = 0; // Zerujemy godziny
                    przeliczDniRobocze();

                } else if (radioDni.checked) {
                    // Tryb 2: Dni aktywne, Data DO zablokowana
                    inputDo.setAttribute("readonly", true);
                    inputDo.style.backgroundColor = "#e9ecef";
                    inputGodziny.value = 0; // Zerujemy godziny
                    wyliczDateKocowa();

                } else if (radioGodziny.checked) {
                    // Tryb 3: GODZINY
                    // Pokazujemy pole godzin
                    sekcjaGodzin.style.display = "block";

                    // Blokujemy datę DO (bo to ten sam dzień)
                    inputDo.setAttribute("readonly", true);
                    inputDo.style.backgroundColor = "#e9ecef";
                    inputDo.value = inputOd.value; // Data Do = Data Od

                    // Blokujemy Dni (bo to 0 dni pełnych)
                    inputDni.setAttribute("readonly", true);
                    inputDni.style.backgroundColor = "#e9ecef";
                    inputDni.value = 0;
                }
            }

            // Nasłuchiwacze
            radioData.addEventListener("change", zmienTryb);
            radioDni.addEventListener("change", zmienTryb);
            radioGodziny.addEventListener("change", zmienTryb);

            // Jeśli zmieni się data OD w trybie godzinowym -> zaktualizuj też datę DO
            inputOd.addEventListener("change", function() {
                if (radioGodziny.checked) {
                    inputDo.value = inputOd.value;
                } else if (radioData.checked) {
                    przeliczDniRobocze();
                } else {
                    wyliczDateKocowa();
                }
            });

            // Nasłuchiwanie na zmianę radio buttonów
            radioData.addEventListener("change", zmienTryb);
            radioDni.addEventListener("change", zmienTryb);

            // --- 2. Logika obliczeń (Ignorowanie Sobót i Niedziel) ---

            // A. Użytkownik zmienia daty -> Liczymy dni
            function przeliczDniRobocze() {
                if (!inputOd.value || !inputDo.value) return;

                const start = new Date(inputOd.value);
                const end = new Date(inputDo.value);

                if (end < start) {
                    inputDni.value = 0;
                    return;
                }

                let count = 0;
                let current = new Date(start);

                // Pętla dzień po dniu
                while (current <= end) {
                    const dayOfWeek = current.getDay(); // 0 = Niedziela, 6 = Sobota
                    if (dayOfWeek !== 0 && dayOfWeek !== 6) {
                        count++;
                    }
                    current.setDate(current.getDate() + 1);
                }

                inputDni.value = count;
            }

            // B. Użytkownik wpisuje dni -> Liczymy datę końca
            function wyliczDateKocowa() {
                if (!inputOd.value || !inputDni.value) return;

                let daysToAdd = parseInt(inputDni.value);
                if (daysToAdd <= 0) return;

                let current = new Date(inputOd.value);
                let addedDays = 0;

                // Uwaga: Dzień startowy też się liczy, jeśli jest roboczy!
                // Jeśli wpiszesz 1 dzień i zaczniesz w poniedziałek, koniec to poniedziałek.

                // Sprawdzamy czy dzień startowy jest roboczy, jeśli tak, to już mamy 1 dzień zaliczony
                let startDay = current.getDay();
                if (startDay !== 0 && startDay !== 6) {
                   addedDays = 1;
                }

                // Pętla dodająca dni
                while (addedDays < daysToAdd) {
                    current.setDate(current.getDate() + 1); // Idziemy o dzień do przodu

                    const dayOfWeek = current.getDay();
                    if (dayOfWeek !== 0 && dayOfWeek !== 6) {
                        addedDays++;
                    }
                }

                // Formatowanie daty do input type="date" (YYYY-MM-DD)
                const yyyy = current.getFullYear();
                const mm = String(current.getMonth() + 1).padStart(2, '0');
                const dd = String(current.getDate()).padStart(2, '0');

                inputDo.value = `${yyyy}-${mm}-${dd}`;
            }

            // --- 3. Podpięcie zdarzeń (Events) ---

            // Gdy zmieni się Data OD -> przeliczamy w zależności od aktywnego trybu
            inputOd.addEventListener("change", function() {
                if (radioData.checked) przeliczDniRobocze();
                else wyliczDateKocowa();
            });

            // Gdy zmieni się Data DO -> (tylko w trybie 1)
            inputDo.addEventListener("change", przeliczDniRobocze);

            // Gdy zmienią się Dni -> (tylko w trybie 2)
            inputDni.addEventListener("input", wyliczDateKocowa);
        });
    </script>
}