@model SystemKadrowy.Core.Domain.Nieobecnosc

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Nieobecnosc</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="PracownikId" class="control-label"></label>
                <select asp-for="PracownikId" class ="form-control" asp-items="ViewBag.PracownikId"></select>
            </div>
            <div class="form-group">
                <label asp-for="DataOd" class="control-label"></label>
                <input asp-for="DataOd" class="form-control" />
                <span asp-validation-for="DataOd" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DataDo" class="control-label"></label>
                <input asp-for="DataDo" class="form-control" />
                <span asp-validation-for="DataDo" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Typ" class="control-label">Rodzaj Nieobecności</label>
                <select asp-for="Typ" class="form-control"
                        asp-items="Html.GetEnumSelectList<SystemKadrowy.Core.Enums.TypNieobecnosc>()">
                </select>
                <span asp-validation-for="Typ" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LiczbaDniRoboczych" class="control-label"></label>
                <input asp-for="LiczbaDniRoboczych" class="form-control" />
                <span asp-validation-for="LiczbaDniRoboczych" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
