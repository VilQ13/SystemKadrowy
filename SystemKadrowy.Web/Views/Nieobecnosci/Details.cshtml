@model SystemKadrowy.Core.Domain.Nieobecnosc

@{
    ViewData["Title"] = "Szczegóły nieobecności";
}

<style>
    .page-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 2rem;
        border-radius: 12px;
        margin-bottom: 2rem;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

        .page-header h1 {
            margin: 0 0 0.5rem 0;
            font-size: 2rem;
            font-weight: 600;
        }

        .page-header p {
            margin: 0;
            opacity: 0.9;
            font-size: 0.95rem;
        }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: #667eea;
        text-decoration: none;
        font-weight: 500;
        margin-bottom: 1.5rem;
        transition: all 0.2s ease;
    }

        .back-link:hover {
            color: #5568d3;
            gap: 0.7rem;
        }

    .details-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        padding: 2rem;
        overflow: hidden;
    }

    .section-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: #212529;
        margin-bottom: 1.5rem;
        padding-bottom: 0.75rem;
        border-bottom: 2px solid #f1f3f5;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .info-item {
        background: #f8f9fa;
        padding: 1.25rem;
        border-radius: 10px;
        border-left: 4px solid #667eea;
    }

    .info-label {
        font-size: 0.85rem;
        color: #868e96;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 0.5rem;
    }

    .info-value {
        font-size: 1.1rem;
        color: #212529;
        font-weight: 500;
    }

    .action-bar {
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid #e9ecef;
        display: flex;
        gap: 1rem;
    }

    .btn-edit {
        background: #667eea;
        color: white;
        padding: 0.6rem 1.5rem;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.2s ease;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

        .btn-edit:hover {
            background: #5568d3;
            transform: translateY(-2px);
            color: white;
        }

    .btn-secondary-custom {
        background: white;
        color: #495057;
        border: 1px solid #dee2e6;
        padding: 0.6rem 1.5rem;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.2s ease;
    }

        .btn-secondary-custom:hover {
            background: #f8f9fa;
            border-color: #adb5bd;
            color: #212529;
        }
</style>

@if (Context.Request.Headers["X-Requested-With"] != "XMLHttpRequest")
{
    <a asp-action="Index" class="back-link">
        ← Powrót do listy
    </a>
}

<div class="page-header">
    <h1>📄 Szczegóły nieobecności</h1>
    <p>Podgląd zarejestrowanego wniosku</p>
</div>

<div class="details-card">
    <div class="section-title">Informacje o wniosku</div>

    <div class="info-grid">
        <div class="info-item">
            <div class="info-label">@Html.DisplayNameFor(model => model.Pracownik)</div>
            <div class="info-value">
                👤 @Html.DisplayFor(model => model.Pracownik.Email)
            </div>
        </div>

        <div class="info-item">
            <div class="info-label">@Html.DisplayNameFor(model => model.Typ)</div>
            <div class="info-value">
                📋 @Html.DisplayFor(model => model.Typ)
            </div>
        </div>

        <div class="info-item">
            <div class="info-label">@Html.DisplayNameFor(model => model.DataOd)</div>
            <div class="info-value">
                📅 @Html.DisplayFor(model => model.DataOd)
            </div>
        </div>

        <div class="info-item">
            <div class="info-label">@Html.DisplayNameFor(model => model.DataDo)</div>
            <div class="info-value">
                🏁 @Html.DisplayFor(model => model.DataDo)
            </div>
        </div>

        <div class="info-item" style="grid-column: 1 / -1;">
            <div class="info-label">Wymiar czasu</div>
            <div class="info-value">
                @if (Model.LiczbaGodzin > 0)
                {
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <span style="color: #0d6efd; font-weight: 700; font-size: 1.2rem;">
                            ⏱️ @Model.LiczbaGodzin.ToString("0.##") godz.
                        </span>
                        <span style="font-size: 0.9rem; color: #6c757d; background: #e9ecef; padding: 2px 8px; border-radius: 4px;">
                            Część dnia
                        </span>
                    </div>
                }
                else
                {
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <span style="color: #2b8a3e; font-weight: 700; font-size: 1.2rem;">
                            🗓️ @Model.LiczbaDniRoboczych dni
                        </span>
                        <span style="font-size: 0.9rem; color: #6c757d; background: #e9ecef; padding: 2px 8px; border-radius: 4px;">
                            Całodzienna
                        </span>
                    </div>
                }
            </div>
        </div>
    </div>

    @if (Context.Request.Headers["X-Requested-With"] != "XMLHttpRequest")
    {
        <div class="action-bar">
            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn-edit">
                ✏️ Edytuj
            </a>
            <a asp-action="Index" class="btn-secondary-custom">
                Powrót do listy
            </a>
        </div>
    }
</div>