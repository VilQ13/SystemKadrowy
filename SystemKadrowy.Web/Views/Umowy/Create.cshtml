@model SystemKadrowy.Core.Domain.Umowa
@using SystemKadrowy.Core.Enums

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Umowa</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="PracownikId" class="control-label"></label>
                <select asp-for="PracownikId" class ="form-control" asp-items="ViewBag.PracownikId"></select>
            </div>
            <div class="form-group">
                <label asp-for="TypUmowy" class="control-label"></label>
                <select asp-for="TypUmowy" class="form-control"
                        asp-items="Html.GetEnumSelectList<SystemKadrowy.Core.Enums.TypUmowy>()">
                </select>
                <span asp-validation-for="TypUmowy" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Stanowisko" class="control-label"></label>
                <input asp-for="Stanowisko" class="form-control" />
                <span asp-validation-for="Stanowisko" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="control-label">Sposób rozliczania</label>
                <select asp-for="SposobWynagradzania" class="form-control"
                        asp-items="Html.GetEnumSelectList<SystemKadrowy.Core.Enums.SposobWynagradzania>()"></select>
                <span asp-validation-for="SposobWynagradzania" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="StawkaBrutto" class="control-label">Stawka (Miesięczna lub Godzinowa)</label>
                <input asp-for="StawkaBrutto" class="form-control" />
                <span asp-validation-for="StawkaBrutto" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DataRozpoczecia" class="control-label"></label>
                <input asp-for="DataRozpoczecia" type="date" class="form-control" />
                <span asp-validation-for="DataRozpoczecia" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DataZakonczenia" class="control-label"></label>
                <input asp-for="DataZakonczenia" type="date" class="form-control" />
                <span asp-validation-for="DataZakonczenia" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="CzyKosztyPodwyzszone" /> @Html.DisplayNameFor(model => model.CzyKosztyPodwyzszone)
                </label>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="CzyUlgaPodatkowa" /> @Html.DisplayNameFor(model => model.CzyUlgaPodatkowa)
                </label>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="CzyStudent" /> @Html.DisplayNameFor(model => model.CzyStudent)
                </label>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="CzyDobrowolneChorobowe" /> @Html.DisplayNameFor(model => model.CzyDobrowolneChorobowe)
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
