@model SystemKadrowy.Core.Domain.Umowa
@using SystemKadrowy.Core.Enums

@{
    ViewData["Title"] = "Edycja Umowy";
}

<style>
    /* 1. Nagłówek w stylu "Edit" (Niebiesko-Fioletowy) */
    .page-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 2rem;
        border-radius: 12px;
        margin-bottom: 2rem;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

        .page-header h1 {
            margin: 0 0 0.5rem 0;
            font-size: 2rem;
            font-weight: 600;
        }

        .page-header p {
            margin: 0;
            opacity: 0.9;
            font-size: 0.95rem;
        }

    /* 2. Link powrotu */
    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: #667eea;
        text-decoration: none;
        font-weight: 500;
        margin-bottom: 1.5rem;
        transition: all 0.2s ease;
    }

        .back-link:hover {
            color: #5568d3;
            gap: 0.7rem;
        }

    /* 3. Główny kontener formularza */
    .form-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        padding: 2rem;
        max-width: 1000px; /* Szerszy formularz dla 2 kolumn */
    }

    .section-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: #212529;
        margin-bottom: 1.5rem;
        padding-bottom: 0.75rem;
        border-bottom: 2px solid #f1f3f5;
        margin-top: 1rem;
    }

    /* 4. Stylowanie inputów */
    .form-label-custom {
        font-weight: 600;
        color: #495057;
        margin-bottom: 0.5rem;
        font-size: 0.9rem;
    }

    .form-control-custom {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 0.75rem;
        transition: all 0.2s ease;
        font-size: 0.95rem;
    }

        .form-control-custom:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
            outline: none;
        }

    .form-group-custom {
        margin-bottom: 1.5rem;
    }

    /* 5. Sekcja ustawień (Checkboxy) */
    .settings-card {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border-radius: 10px;
        padding: 1.5rem;
        border: 1px solid #dee2e6;
        border-left: 4px solid #667eea;
    }

    .form-check-custom {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.5rem 0;
    }

    .form-check-input {
        width: 1.2em;
        height: 1.2em;
        cursor: pointer;
    }

    .form-check-label {
        cursor: pointer;
        font-weight: 500;
        color: #495057;
    }

    /* 6. Przycisk zapisu (Zielony) */
    .btn-save {
        background: linear-gradient(135deg, #51cf66 0%, #40c057 100%);
        color: white;
        padding: 0.875rem 2.5rem;
        border-radius: 8px;
        border: none;
        font-weight: 600;
        font-size: 1rem;
        transition: all 0.3s ease;
        box-shadow: 0 2px 4px rgba(81, 207, 102, 0.3);
        cursor: pointer;
    }

        .btn-save:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(81, 207, 102, 0.4);
        }

    .text-danger {
        font-size: 0.85rem;
        margin-top: 0.25rem;
    }
</style>

<a asp-action="Index" class="back-link">
    ← Powrót do listy
</a>

<div class="page-header">
    <h1>📝 Edycja umowy</h1>
    <p>Zaktualizuj warunki zatrudnienia pracownika</p>
</div>

<div class="form-card">
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />

        <div class="section-title" style="margin-top: 0;">Dane podstawowe</div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group-custom">
                    <label asp-for="PracownikId" class="form-label-custom">👤 Pracownik</label>
                    <select asp-for="PracownikId" class="form-control form-control-custom" asp-items="ViewBag.PracownikId"></select>
                    <span asp-validation-for="PracownikId" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group-custom">
                    <label asp-for="Stanowisko" class="form-label-custom">💼 Stanowisko</label>
                    <input asp-for="Stanowisko" class="form-control form-control-custom" placeholder="np. Programista .NET" />
                    <span asp-validation-for="Stanowisko" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="form-group-custom">
            <label asp-for="TypUmowy" class="form-label-custom">📄 Rodzaj umowy</label>
            <select asp-for="TypUmowy" class="form-control form-control-custom"
                    asp-items="Html.GetEnumSelectList<SystemKadrowy.Core.Enums.TypUmowy>()">
            </select>
            <span asp-validation-for="TypUmowy" class="text-danger"></span>
        </div>

        <div class="section-title">Warunki finansowe i czasowe</div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group-custom">
                    <label asp-for="SposobWynagradzania" class="form-label-custom">📊 Sposób rozliczania</label>
                    <select asp-for="SposobWynagradzania" class="form-control form-control-custom"
                            asp-items="Html.GetEnumSelectList<SystemKadrowy.Core.Enums.SposobWynagradzania>()"></select>
                    <span asp-validation-for="SposobWynagradzania" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group-custom">
                    <label asp-for="StawkaBrutto" class="form-label-custom">💰 Stawka (PLN)</label>
                    <input asp-for="StawkaBrutto" class="form-control form-control-custom" placeholder="0.00" />
                    <span asp-validation-for="StawkaBrutto" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group-custom">
                    <label asp-for="DataRozpoczecia" class="form-label-custom">📅 Data rozpoczęcia</label>
                    <input asp-for="DataRozpoczecia" type="date" class="form-control form-control-custom" />
                    <span asp-validation-for="DataRozpoczecia" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group-custom">
                    <label asp-for="DataZakonczenia" class="form-label-custom">🏁 Data zakończenia</label>
                    <input asp-for="DataZakonczenia" type="date" class="form-control form-control-custom" />
                    <span asp-validation-for="DataZakonczenia" class="text-danger"></span>
                    <small class="text-muted" style="font-size: 0.8rem; display: block; margin-top: 0.25rem;">Pozostaw puste dla umowy na czas nieokreślony</small>
                </div>
            </div>
        </div>

        <div class="section-title">Ustawienia podatkowe i ZUS</div>

        <div class="settings-card">
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group-custom form-check-custom">
                        <input class="form-check-input" asp-for="CzyKosztyPodwyzszone" />
                        <label class="form-check-label" asp-for="CzyKosztyPodwyzszone">
                            📈 @Html.DisplayNameFor(model => model.CzyKosztyPodwyzszone)
                        </label>
                    </div>

                    <div class="form-group-custom form-check-custom">
                        <input class="form-check-input" asp-for="CzyUlgaPodatkowa" />
                        <label class="form-check-label" asp-for="CzyUlgaPodatkowa">
                            📉 @Html.DisplayNameFor(model => model.CzyUlgaPodatkowa)
                        </label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group-custom form-check-custom">
                        <input class="form-check-input" asp-for="CzyStudent" />
                        <label class="form-check-label" asp-for="CzyStudent">
                            🎓 @Html.DisplayNameFor(model => model.CzyStudent) <small class="text-muted">(do 26 roku życia)</small>
                        </label>
                    </div>

                    <div class="form-group-custom form-check-custom">
                        <input class="form-check-input" asp-for="CzyDobrowolneChorobowe" />
                        <label class="form-check-label" asp-for="CzyDobrowolneChorobowe">
                            🏥 @Html.DisplayNameFor(model => model.CzyDobrowolneChorobowe)
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-group-custom" style="margin-top: 2.5rem;">
            <button type="submit" class="btn-save">💾 Zapisz zmiany</button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}