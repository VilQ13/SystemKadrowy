@model SystemKadrowy.Core.Domain.Pracownik

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Pracownik</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ZdjecieSciezka" />
            <input type="hidden" asp-for="AdresZamieszkania.Id" />
            <div class="col-md-6 mb-3">
                <label class="control-label fw-bold">Zdjęcie profilowe</label>

                @if (!string.IsNullOrEmpty(Model.ZdjecieSciezka))
                {
                    <div class="mb-2">
                        <img src="~/zdjecia/@Model.ZdjecieSciezka" style="max-width: 150px; border-radius: 5px;" />
                    </div>
                }

                <input type="file" name="plikZdjecia" class="form-control" accept=".jpg,.jpeg,.png" />
                <small class="text-muted">Pozostaw puste, aby zachować obecne zdjęcie.</small>
            </div>
            <div class="form-group">
                <label asp-for="Imie" class="control-label"></label>
                <input asp-for="Imie" class="form-control" />
                <span asp-validation-for="Imie" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Nazwisko" class="control-label"></label>
                <input asp-for="Nazwisko" class="form-control" />
                <span asp-validation-for="Nazwisko" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PESEL" class="control-label"></label>
                <input asp-for="PESEL" class="form-control" />
                <span asp-validation-for="PESEL" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DataUrodzenia" class="control-label"></label>
                <input asp-for="DataUrodzenia" type="date" class="form-control" asp-format="{0:yyyy-MM-dd}" />
                <span asp-validation-for="DataUrodzenia" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <h4>Dane podstawowe</h4>
                    <div class="form-group mb-3">
                        <label asp-for="Telefon" class="control-label"></label>
                        <input asp-for="Telefon" class="form-control" />
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="NumerKontaBankowego" class="control-label">Nr Konta Bankowego</label>
                        <input asp-for="NumerKontaBankowego" class="form-control" />
                    </div>
                </div>

                <div class="col-md-6">
                    <h4 class="text-primary">Adres Zamieszkania</h4>
                    <div class="card p-3 bg-light">

                        <div class="row">
                            <div class="col-4">
                                <div class="form-group mb-3">
                                    <label class="control-label">Kod</label>
                                    <input asp-for="AdresZamieszkania.KodPocztowy.Kod" class="form-control" placeholder="00-000" />
                                </div>
                            </div>
                            <div class="col-8">
                                <div class="form-group mb-3">
                                    <label class="control-label">Miejscowość</label>
                                    <input asp-for="AdresZamieszkania.KodPocztowy.Miejscowosc" class="form-control" />
                                </div>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="AdresZamieszkania.Ulica" class="control-label">Ulica</label>
                            <input asp-for="AdresZamieszkania.Ulica" class="form-control" />
                        </div>

                        <div class="row">
                            <div class="col-6">
                                <div class="form-group mb-3">
                                    <label asp-for="AdresZamieszkania.NumerDomu" class="control-label">Nr Domu</label>
                                    <input asp-for="AdresZamieszkania.NumerDomu" class="form-control" />
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-group mb-3">
                                    <label asp-for="AdresZamieszkania.NumerLokalu" class="control-label">Nr Lokalu</label>
                                    <input asp-for="AdresZamieszkania.NumerLokalu" class="form-control" />
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
