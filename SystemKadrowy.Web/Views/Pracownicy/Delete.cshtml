@model SystemKadrowy.Core.Domain.Pracownik
@{
    ViewData["Title"] = "Usuń pracownika";
}

<style>
    .page-header {
        background: linear-gradient(135deg, #fa5252 0%, #e03131 100%);
        color: white;
        padding: 2rem;
        border-radius: 12px;
        margin-bottom: 2rem;
        box-shadow: 0 4px 6px rgba(250, 82, 82, 0.3);
    }

        .page-header h1 {
            margin: 0 0 0.5rem 0;
            font-size: 2rem;
            font-weight: 600;
        }

        .page-header p {
            margin: 0;
            opacity: 0.9;
            font-size: 0.95rem;
        }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: #667eea;
        text-decoration: none;
        font-weight: 500;
        margin-bottom: 1.5rem;
        transition: all 0.2s ease;
    }

        .back-link:hover {
            color: #5568d3;
            gap: 0.7rem;
        }

    .warning-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        overflow: hidden;
        max-width: 700px;
        margin: 0 auto;
    }

    .warning-banner {
        background: linear-gradient(135deg, #fff3cd 0%, #ffe69c 100%);
        padding: 1.5rem;
        border-bottom: 3px solid #ffc107;
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .warning-icon {
        font-size: 3rem;
        flex-shrink: 0;
    }

    .warning-text h3 {
        margin: 0 0 0.5rem 0;
        color: #856404;
        font-size: 1.5rem;
        font-weight: 700;
    }

    .warning-text p {
        margin: 0;
        color: #856404;
        font-size: 1rem;
    }

    .employee-details {
        padding: 2rem;
    }

    .section-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #495057;
        margin-bottom: 1.5rem;
        padding-bottom: 0.75rem;
        border-bottom: 2px solid #f1f3f5;
    }

    .info-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
    }

    .info-row {
        display: flex;
        padding: 1rem;
        background: #f8f9fa;
        border-radius: 8px;
        border-left: 4px solid #fa5252;
    }

    .info-label {
        flex: 0 0 150px;
        font-weight: 600;
        color: #495057;
        font-size: 0.9rem;
    }

    .info-value {
        flex: 1;
        color: #212529;
        font-size: 1rem;
        font-weight: 500;
    }

    .action-section {
        padding: 2rem;
        background: #f8f9fa;
        border-top: 2px solid #e9ecef;
    }

    .action-buttons {
        display: flex;
        gap: 1rem;
        justify-content: center;
    }

    .btn-delete {
        background: linear-gradient(135deg, #fa5252 0%, #e03131 100%);
        color: white;
        padding: 0.875rem 2.5rem;
        border-radius: 8px;
        border: none;
        font-weight: 600;
        font-size: 1rem;
        transition: all 0.3s ease;
        box-shadow: 0 2px 4px rgba(250, 82, 82, 0.3);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

        .btn-delete:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(250, 82, 82, 0.4);
            background: linear-gradient(135deg, #e03131 0%, #c92a2a 100%);
        }

    .btn-cancel {
        background: white;
        color: #495057;
        padding: 0.875rem 2.5rem;
        border-radius: 8px;
        border: 2px solid #dee2e6;
        font-weight: 600;
        font-size: 1rem;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

        .btn-cancel:hover {
            background: #f8f9fa;
            border-color: #adb5bd;
            color: #495057;
            transform: translateY(-2px);
        }

    .danger-note {
        background: #ffe0e0;
        border: 1px solid #ffc9c9;
        border-radius: 8px;
        padding: 1rem;
        margin-top: 1.5rem;
        color: #c92a2a;
        font-size: 0.9rem;
        display: flex;
        align-items: start;
        gap: 0.75rem;
    }

    .danger-note-icon {
        font-size: 1.2rem;
        flex-shrink: 0;
    }
</style>

<a asp-action="Index" class="back-link">
    ← Powrót do listy
</a>

<div class="page-header">
    <h1>⚠️ Usuwanie pracownika</h1>
    <p>Ta operacja jest nieodwracalna</p>
</div>

<div class="warning-card">
    <div class="warning-banner">
        <div class="warning-icon">⚠️</div>
        <div class="warning-text">
            <h3>Czy na pewno chcesz usunąć tego pracownika?</h3>
            <p>Ta operacja spowoduje trwałe usunięcie danych z systemu</p>
        </div>
    </div>

    <div class="employee-details">
        <div class="section-title">Dane pracownika do usunięcia</div>

        <div class="info-grid">
            <div class="info-row">
                <div class="info-label">@Html.DisplayNameFor(model => model.Imie)</div>
                <div class="info-value">@Html.DisplayFor(model => model.Imie)</div>
            </div>

            <div class="info-row">
                <div class="info-label">@Html.DisplayNameFor(model => model.Nazwisko)</div>
                <div class="info-value">@Html.DisplayFor(model => model.Nazwisko)</div>
            </div>

            <div class="info-row">
                <div class="info-label">@Html.DisplayNameFor(model => model.PESEL)</div>
                <div class="info-value">@Html.DisplayFor(model => model.PESEL)</div>
            </div>

            <div class="info-row">
                <div class="info-label">@Html.DisplayNameFor(model => model.DataUrodzenia)</div>
                <div class="info-value">@Html.DisplayFor(model => model.DataUrodzenia)</div>
            </div>

            <div class="info-row">
                <div class="info-label">@Html.DisplayNameFor(model => model.Email)</div>
                <div class="info-value">@Html.DisplayFor(model => model.Email)</div>
            </div>
        </div>

        <div class="danger-note">
            <div class="danger-note-icon">🛑</div>
            <div>
                <strong>Uwaga!</strong> Usunięcie pracownika spowoduje również usunięcie powiązanych danych, takich jak umowy, wypłaty i historia zatrudnienia. Tej operacji nie można cofnąć.
            </div>
        </div>
    </div>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />

        <div class="action-section">
            <div class="action-buttons">
                <a asp-action="Index" class="btn-cancel">
                    ← Anuluj
                </a>
                <button type="submit" class="btn-delete">
                    🗑️ Usuń pracownika
                </button>
            </div>
        </div>
    </form>
</div>